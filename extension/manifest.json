{
  "manifest_version": 2,
  "name": "Meeting CLI Bridge",
  "version": "0.1.0",
  "description": "Detecta calls do Microsoft Teams e aciona o meeting-cli para gravar, transcrever e organizar notas automaticamente.",
  "browser_specific_settings": {
    "gecko": {
      "id": "meeting-cli-bridge@gabrielcraveiro.dev",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "http://localhost:7899/*",
    "http://127.0.0.1:7899/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": ["content-teams.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_title": "Meeting CLI Bridge"
  }
}
